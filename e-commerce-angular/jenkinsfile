pipeline {
    agent any

    environment {
        IMAGE_NAME = 'angular-ecommerce'
        CONTAINER_NAME = 'angular-ecommerce-app'
        APP_PORT = '4200'
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

       
    stage('Build Docker Image') {
        steps {
            dir('e-commerce-angular') {
            sh 'docker build -t angular-ecommerce:${BUILD_NUMBER} .'
        }
    }
    
    }
    stage('Build Docker Image') {
            steps {
                sh 'docker build -t ${IMAGE_NAME}:${BUILD_NUMBER} .'
            }
        }

        stage('Test') {
            steps {
                sh 'docker run --rm ${IMAGE_NAME}:${BUILD_NUMBER} npm test -- --watch=false'
            }
        }

        stage('Deploy') {
            steps {
                sh '''
                    docker stop ${CONTAINER_NAME} || true
                    docker rm ${CONTAINER_NAME} || true

                    docker run -d \
                        --name ${CONTAINER_NAME} \
                        --restart unless-stopped \
                        -p 80:${APP_PORT} \
                        ${IMAGE_NAME}:${BUILD_NUMBER}
                '''
            }
        }
    }

    post {
        success {
            echo 'CI/CD Pipeline completed successfully!'
        }

        failure {
            echo 'Pipeline failed. Check the Jenkins console output.'
        }
    }
}
