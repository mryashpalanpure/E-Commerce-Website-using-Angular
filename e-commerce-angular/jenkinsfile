pipeline {
    agent {label 'vinod'}

    environment {
        IMAGE_NAME = 'angularimagevinods'
        CONTAINER_NAME = 'angularapplicationvinods'
        APP_PORT = '4200'
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build Docker Image') {
            steps {
                dir('e-commerce-angular') {
                    sh 'docker build -t ${IMAGE_NAME}:${BUILD_NUMBER} .'
                }
            }
        }

        stage('Test') {
            steps {
                dir('e-commerce-angular') {
                    sh 'docker run --rm ${IMAGE_NAME}:${BUILD_NUMBER} npm test -- --watch=false'
                    echo 'Image is ready to push to the docker hub'
                }
            }
        }

        stage('Pushed Image to Docker Hub'){
            steps{
                withCredentials([
                    usernamePassword(
                        credentialsId : 'username',
                        usernameVariable : 'docker_user',
                        passwordVariable : 'docker_pass'
                    )
                ])
                {
                    sh '''
                        docker login -u usernameVariable -p passwordVariable
                        docker push $docker_user/${IMAGE_NAME}:${BUILD_NUMBER}
                    '''
                }
            }
        }

        stage('Deploy') {
            steps {
                sh '''
                    docker stop ${CONTAINER_NAME} || true
                    docker rm ${CONTAINER_NAME} || true

                    docker run -d \
                        --name ${CONTAINER_NAME} \
                        --restart unless-stopped \
                        -p 80:${APP_PORT} \
                        ${IMAGE_NAME}:${BUILD_NUMBER}
                '''
            }
        }
    }

    post {
        success {
            echo 'CI/CD Pipeline completed successfully!'
        }

        failure {
            echo 'Pipeline failed. Check the Jenkins console output.'
        }
    }
}
